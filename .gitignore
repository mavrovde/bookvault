# Secrets and local per-user state -- never commit these.
.env
.litres_session.json
.litres_cache.json
.litres_state.json

# Python runtime / build artifacts
.venv/
__pycache__/
*.pyc
*.egg
*.egg-info/
build/
dist/

# Tooling caches and coverage output
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Desktop build artifacts (PyInstaller / installers)
packaging/*/build/
packaging/*/dist/

# OS metadata files (macOS Finder, Windows Explorer)
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Playwright MCP browser output (page snapshots, screenshots). Written into
# the repo root when driving the app in a browser; never part of the project,
# and a snapshot of a logged-in page contains the library it was taken from.
.playwright-mcp/

# Editor / IDE settings (per-developer, not project configuration)
.idea/
.vscode/
*.code-workspace
